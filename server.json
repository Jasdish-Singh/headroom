{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Jasdish-Singh/headroom",
  "title": "Headroom",
  "description": "Watch RAM and disk on your Windows PC. Cleanup tools return plans only.",
  "repository": {
    "url": "https://github.com/Jasdish-Singh/headroom",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "headroom-pc",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
